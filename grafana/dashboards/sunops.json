{
  "uid": "sunops-main",
  "title": "SunOps \u00b7 OZZ-1 solar plant",
  "tags": [
    "sunops"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "2026-03-01T00:00:00Z",
    "to": "2026-03-17T00:00:00Z"
  },
  "panels": [
    {
      "id": 1,
      "title": "Energy, last day",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select sum(energy_kwh)/1000.0 as mwh from analytics.fct_daily_performance where date_day = (select max(date_day) from analytics.fct_daily_performance)"
        }
      ],
      "description": "MWh produced by the 24 arrays",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Plant Performance Ratio",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select sum(energy_kwh)/nullif(sum(reference_kwh),0) as pr from analytics.fct_daily_performance where date_day = (select max(date_day) from analytics.fct_daily_performance)"
        }
      ],
      "description": "Energy produced / energy an ideal plant would produce under the same sun",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Arrays to clean",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select count(*) from analytics.mart_cleaning_recommendations where date_day = (select max(date_day) from analytics.fct_daily_performance) and recommendation in ('CLEAN_NOW','SCHEDULE')"
        }
      ],
      "description": "CLEAN_NOW + SCHEDULE",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Revenue lost to dust (MAD)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select sum(lost_revenue_mad) from analytics.mart_cleaning_recommendations where date_day = (select max(date_day) from analytics.fct_daily_performance) and recommendation <> 'INSPECT'"
        }
      ],
      "description": "Value of the energy lost to soiling on the last day",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Daily energy by zone (MWh)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select to_char(date_day,'MM-DD') as day, sum(case when zone='A' then energy_kwh end)/1000 as \"Zone A\", sum(case when zone='B' then energy_kwh end)/1000 as \"Zone B\", sum(case when zone='C' then energy_kwh end)/1000 as \"Zone C\" from analytics.fct_daily_performance group by date_day order by date_day"
        }
      ],
      "options": {
        "stacking": "normal",
        "xField": "day",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Zone A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Zone B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Zone C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Performance Ratio by zone (zone C robot is down)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select date_day::timestamp as time, 'Zone ' || zone as metric, sum(energy_kwh)/nullif(sum(reference_kwh),0) as value from analytics.fct_daily_performance group by 1,2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Zone A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Zone B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Zone C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Cleaning plan for the last day",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select array_id, zone, recommendation, soiling_loss_pct as \"soiling loss %\", lost_energy_kwh as \"lost kWh\", lost_revenue_mad as \"lost MAD\" from analytics.mart_cleaning_recommendations where date_day = (select max(date_day) from analytics.fct_daily_performance) and recommendation <> 'OK' order by lost_revenue_mad desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "recommendation"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CLEAN_NOW": {
                        "color": "red",
                        "index": 0
                      },
                      "SCHEDULE": {
                        "color": "orange",
                        "index": 1
                      },
                      "INSPECT": {
                        "color": "purple",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Data health (Spark Bronze -> Silver)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select finished_at, rows_read, rows_silver, rows_quarantined, duplicates_removed, quarantine_pct as \"quarantine %\", contract_version from ops.pipeline_runs order by finished_at desc limit 20"
        }
      ]
    },
    {
      "id": 9,
      "title": "Data Canary history (Jenkins)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sunops-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sunops-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select created_at, build_id, git_sha, verdict, score, failed_checks from ops.canary_runs order by created_at desc limit 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PROMOTE": {
                        "color": "green",
                        "index": 0
                      },
                      "BLOCK": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}